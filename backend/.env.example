GEMINI_API_KEY=your-key-here

# Model IDs (override if the venue uses different ids)
ARGON_MODEL=gemini-4-argon
FLASH_MODEL=gemini-3.8-flash
LITE_MODEL=gemini-3.5-flash-lite
# Tried in order when a tier's model is overloaded / over quota / too slow
FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# Browser: unset = use the Chrome extension when connected, else HTTP fetch. none|extension|cdp
# BROWSER_BACKEND=

# Agent tuning
# AGENT_MAX_STEPS=10
# AGENT_STEP_TIMEOUT=45
# AGENT_SOFT_DEADLINE=75
# AGENT_HARD_DEADLINE=150
# INGEST_CONCURRENCY=8
